+                    candidate_height = (
+                        int.from_bytes(data[child_end - 4 : child_end], "big")
+                        >> 16
+                    )
+                    if candidate_width > 0 and candidate_height > 0:
+                        width, height = candidate_width, candidate_height
+                        break
