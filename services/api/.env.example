# Copy to .env for local development. Never use these development defaults in production.
JIANGHU_ENVIRONMENT=development
JIANGHU_DATABASE_URL=postgresql+psycopg://jianghu:local-development-only@127.0.0.1:55432/jianghu
JIANGHU_REDIS_URL=redis://127.0.0.1:16379/0
JIANGHU_LUGGAGE_CACHE_TTL_SECONDS=30
JIANGHU_ALLOWED_HOSTS=["127.0.0.1","localhost","10.0.2.2","testserver"]

# Generate independent random values before any shared or production deployment.
JIANGHU_JWT_SECRET=replace-with-at-least-32-random-characters
JIANGHU_PHONE_LOOKUP_KEY=replace-with-at-least-32-random-characters
JIANGHU_VERIFICATION_CODE_KEY=replace-with-at-least-32-random-characters
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JIANGHU_PHONE_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
JIANGHU_CURRENT_TERMS_VERSION=2026-08
JIANGHU_CURRENT_PRIVACY_VERSION=2026-08

# Development only. Production startup rejects a fixed verification code.
JIANGHU_FIXED_VERIFICATION_CODE=123456
JIANGHU_SMS_PROVIDER=noop

# Media services are provided by infra/docker-compose.yml.
JIANGHU_MEDIA_STORAGE_PROVIDER=minio
JIANGHU_MINIO_ENDPOINT=127.0.0.1:19000
JIANGHU_MINIO_PUBLIC_ENDPOINT=127.0.0.1:19000
JIANGHU_MINIO_REGION=us-east-1
JIANGHU_MINIO_ACCESS_KEY=jianghu-local
JIANGHU_MINIO_SECRET_KEY=jianghu-local-secret-change-me
JIANGHU_MINIO_SECURE=false
JIANGHU_MINIO_PUBLIC_SECURE=false
JIANGHU_MEDIA_VIRUS_SCANNER=clamav
JIANGHU_CLAMAV_HOST=127.0.0.1
JIANGHU_CLAMAV_PORT=3310
JIANGHU_INTERNAL_WORKER_TOKEN=replace-with-a-separate-32-character-internal-token
JIANGHU_MEDIA_MAX_UPLOAD_BYTES=20971520
JIANGHU_MEDIA_MAX_IMAGE_PIXELS=40000000

# Image generation. "development" is a deterministic local preview and is rejected
# in production. For a real provider set "openai" and supply the server-side key.
JIANGHU_IMAGE_GENERATION_PROVIDER=development
JIANGHU_IMAGE_GENERATION_MODEL=gpt-image-2-2026-04-21
JIANGHU_IMAGE_GENERATION_DAILY_LIMIT=6
JIANGHU_IMAGE_GENERATION_MAX_RETRIES=2
JIANGHU_IMAGE_GENERATION_TIMEOUT_SECONDS=180
JIANGHU_OPENAI_API_KEY=
JIANGHU_OPENAI_BASE_URL=https://api.openai.com/v1

# Conference match judging. "development" uses a transparent deterministic scorer.
# Production may use "webhook" to call an internal model gateway, or "disabled"
# when judgments are written through the protected internal API only.
JIANGHU_CONFERENCE_JUDGE_PROVIDER=development
JIANGHU_CONFERENCE_JUDGE_MODEL=conference-judge-v1
JIANGHU_CONFERENCE_JUDGE_WEBHOOK_URL=
JIANGHU_CONFERENCE_JUDGE_WEBHOOK_TOKEN=
JIANGHU_CONFERENCE_JUDGE_TIMEOUT_SECONDS=30
JIANGHU_OUTBOX_MAX_ATTEMPTS=5
JIANGHU_OUTBOX_LEASE_SECONDS=300
